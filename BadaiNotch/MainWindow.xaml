<Window x:Class="BadaiNotch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Badai Notch"
        Height="90"
        Width="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style x:Key="EyeStyle" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="#F2F5F7"/>
            <Setter Property="BorderBrush" Value="#DDE7EE"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="24"
            Background="#0F172A"
            BorderBrush="#334155"
            BorderThickness="1"
            Padding="10,8,10,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource EyeStyle}"
                    x:Name="EyeLeft"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border Background="#0B1220" CornerRadius="9" Width="9" Height="9" Margin="6"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0">
                <TextBlock x:Name="NextPrayerText"
                           Foreground="#F8FAFC"
                           FontWeight="Bold"
                           FontSize="17"
                           HorizontalAlignment="Center"
                           Text="Ashar"/>
                <TextBlock x:Name="CountdownText"
                           Foreground="#A5B4FC"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Text="00:12:34"/>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource EyeStyle}"
                    x:Name="EyeRight"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border Background="#0B1220" CornerRadius="9" Width="9" Height="9" Margin="6"/>
            </Border>
        </Grid>
    </Border>
</Window>
