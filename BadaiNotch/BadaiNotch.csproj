using System;
using System.Media;
using System.Windows;

namespace BadaiNotch;

public sealed class PrayerNotificationService
{
    public void ShowPrayerNotification(string prayerName, DateTime prayerTime)
    {
        try
        {
            SystemSounds.Beep.Play();
        }
        catch
        {
            // ignore sound errors, still show the message if needed
        }

        var message = $"{prayerName} akan dimulai pada {prayerTime:HH:mm}.";
        MessageBox.Show(message, "Waktu Shalat", MessageBoxButton.OK, MessageBoxImage.Information);
    }
}
