$ErrorActionPreference = "Stop"

$projectPath = Join-Path $PSScriptRoot "BadaiNotch\BadaiNotch.csproj"
$outputPath = Join-Path $PSScriptRoot "publish"

Write-Host "Restoring project..."
dotnet restore $projectPath

Write-Host "Publishing Windows app..."
dotnet publish $projectPath -c Release -r win-x64 --self-contained false -p:PublishSingleFile=true -o $outputPath

Write-Host "Publish complete. Output folder: $outputPath"
